C 0x81D4 los sprites a la VRAM
C 0x81D7 ENASCR
C 0x81DA la musica 2
C 0x81E2 las cuentas y los botones a 0
C 0x81F2 0xE1B1 = 0x80
C 0x81F7 la fase 1?
C 0x8201 la 5?
C 0x8208 las otras: Y 0x9F, X 0x7C
L 0x821A fase5_sitio               La 5: Y 0x6F, X 0x7C
L 0x822A fase_cero
L 0x8237 fase_bucle                El bucle de la fase: un paso por cuadro (0xE011); se acaba con 0xE183 (0x8B7B) o 0xE186 (0x8C49)
C 0x8237 0xE183?
C 0x823E 0xE186?
L 0x8245 fase_cuadro               Un cuadro: los sprites, el protagonista, los otros, la salida de los otros, el sonido y lo demas
C 0x8245 un cuadro?
C 0x824C gastado
L 0x826E fase_sigue                En la demostracion, el boton vuelve al titulo
C 0x826E en partida, sigue
C 0x8274 el boton de empezar?
C 0x827A al titulo
L 0x827D fase1_salida              En la fase 1: con 0xE1D1 y el protagonista arriba (Y menos de 0x52) en la columna 0x79-0x7D, la fase se acaba (0xE186)
C 0x8288 arriba?
C 0x828E en la columna?
C 0x8297 la fase se acaba
L 0x829D sonido_e1b4               Con 0xE1B4, el efecto 2
L 0x82A8 salen                     Cuando la cuenta de 0xE1B1 llega a 0, salen otros; a 0x28 en la fase 1, seis mas (0xE304)
C 0x82AC a 0: salen
C 0x82AE 0x28?
L 0x82B2 salen_cuenta              La cuenta, uno menos
L 0x82BC salen_28
L 0x82C7 salen_seis
L 0x82CF salen_seis_uno
C 0x82D3 el tipo 6
L 0x82D8 salen_seis_sig
L 0x82DE salen_otro                La cuenta nueva (al azar) y otro que sale segun la fase
C 0x82DE al azar 0-63
C 0x82E8 la fase 1: 16 + eso
L 0x82EF salen_fase                Las otras: 0x60 - (fase + 1) x 8 + eso
